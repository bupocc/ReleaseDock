# 复制为 .env；管理员通过 Bitwarden 等认证器保存的通行密钥登录。
# 首次启动后运行 pnpm passkey:setup，生成仅保存在本地文件的一次性注册链接。
PORT=8080
HOST=127.0.0.1
DATA_DIR=./.data
MAX_UPLOAD_MB=2048
SESSION_HOURS=12
# 对外使用 HTTPS 时设为 true，开启仅 HTTPS 可发送的会话 Cookie。
COOKIE_SECURE=false
# 正式部署必须填写固定 HTTPS 域名，如 https://releases.example.com。
# 留空仅允许 http://localhost:PORT 完成通行密钥认证，不支持以 IP 地址注册。
PUBLIC_URL=
# 宿主机已有 HTTPS 反向代理时设为 1，按可信来源读取转发协议；直接访问时保持 0。
TRUST_PROXY=0
# 默认覆盖回环地址与 Docker 私网；可替换为实际代理 IP/CIDR，多个值以逗号分隔。
# 启用后应保持下方 BIND_ADDRESS=127.0.0.1，仅允许可信代理访问应用端口。
TRUSTED_PROXY_CIDRS=loopback,uniquelocal
# 使用 compose.https.yaml 时填写实际域名，不包含 https://。
DOMAIN=
# 默认只监听本机；云服务器通过 HTTPS 反向代理对外提供服务。
BIND_ADDRESS=127.0.0.1
