# 复制为 .env，填写至少 32 个字符的随机管理员密钥。
# 可运行 pnpm key:generate 生成本地 .env；此命令不会在终端回显密钥。
ADMIN_KEY=
PORT=8080
HOST=127.0.0.1
DATA_DIR=./.data
MAX_UPLOAD_MB=2048
SESSION_HOURS=12
# 对外使用 HTTPS 时设为 true，开启仅 HTTPS 可发送的会话 Cookie。
COOKIE_SECURE=false
# HTTPS 部署时填写域名，例如 https://releases.example.com。
PUBLIC_URL=
# 使用 compose.https.yaml 时填写实际域名，不包含 https://。
DOMAIN=
# 默认只监听本机；云服务器通过 HTTPS 反向代理对外提供服务。
BIND_ADDRESS=127.0.0.1
